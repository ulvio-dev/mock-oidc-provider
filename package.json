{
  "name": "mock-oidc-provider",
  "version": "1.0.0",
  "description": "Mock OIDC-compatible IdP based on config file",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "node -r dotenv/config dist/server.js",
    "dev": "npm run build && npm start",
    "clean": "rm -rf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ulvio-dev/mock-oidc-provider.git"
  },
  "keywords": [
    "oidc",
    "oauth2",
    "mock",
    "identity-provider"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ulvio-dev/mock-oidc-provider/issues"
  },
  "homepage": "https://github.com/ulvio-dev/mock-oidc-provider#readme",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
