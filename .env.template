# Mock OIDC Provider Environment Variables
# Copy this file to .env and fill in your values

# OAuth Client Configuration (Required)
# These can also be provided via data/settings.json, but environment variables take priority
MOCK_CLIENT_ID=careportal-client
MOCK_CLIENT_SECRET=your-secret-here
MOCK_REDIRECT_URI=http://localhost:4200/api/auth/callback

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: HTTP Basic Authentication
# Uncomment to protect the admin interface
# WEB_USER=admin
# WEB_PASS=your-password-here

# Optional: URL Routing
# Uncomment to run under a custom base path
# BASE_PATHNAME=/oidc
# BASE_URL=https://your-domain.com/oidc

# ===================================
# 1Password Integration (Recommended)
# ===================================
# To use 1Password CLI for secret injection:
#
# 1. Replace the secret values above with 1Password references:
#    MOCK_CLIENT_SECRET=op://Dev/mock-identity/clientSecret
#
# 2. Run with 1Password injection:
#    op inject -i .env.template -o .env
#    docker-compose up -d
#
# Or use op run:
#    op run --env-file=.env.template -- docker-compose up -d
